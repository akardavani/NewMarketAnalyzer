@page
@model MarketAnalyzer.Portal.Pages.OnlineDepositCallbackModel
@{
    ViewData["Title"] = "نتیجه پرداخت آنلاین";
    Layout = "_RegistrationLayout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="d-flex flex-column align-items-center shadow border w-50 gap-3 rounded-3 py-5">
        @if (Model.Successed)
        {
            <div class="issuance-request-result successed d-flex flex-column align-items-center justify-content-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" fill="currentColor" class="bi bi-check2-circle" viewBox="0 0 16 16">
                    <path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0" />
                    <path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0z" />
                </svg>
                <strong>عملیات پرداخت با موفقیت انجام شد.</strong>
            </div>
            <div>
                <p class="mb-2">شناسه پرداخت: @Model.DepositId</p>
                <p class="mb-2">مبلغ واریزی: @Model.Amount</p>
                <p class="mb-2">شناسه تراکنش: @Model.TransactionId</p>
            </div>
            <a asp-page="RequestList" data-type="primary-buttons">انتقال به لیست درخواست‌ها</a>
        }
        else
        {
            <div class="issuance-request-result failed d-flex flex-column align-items-center justify-content-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" fill="currentColor" class="bi bi-x-circle" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                </svg>
                <strong>عملیات پرداخت موفقیت‌آمیز نبود.</strong>
            </div>
            <div>
                <p class="mb-2">شناسه پرداخت: @Model.DepositId</p>
                <p class="mb-2">مبلغ واریزی: @Model.Amount</p>
                <p class="mb-2">شناسه تراکنش: @Model.TransactionId</p>
            </div>
            <a asp-page="IssuanceRequest" data-type="primary-buttons">بازگشت به درخواست صدور</a>
        }
    </div>
</div>
