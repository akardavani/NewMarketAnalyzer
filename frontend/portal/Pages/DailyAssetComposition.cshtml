@page
@model DailyAssetCompositionModel
@{
    ViewData["Title"] = "ترکیب دارایی‌های روزانه";
}

<div class="container">
    <div class="d-flex flex-column">
        <h3 data-type="pre-titles" class="align-self-center">ترکیب دارایی‌های روزانه</h3>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-1 w-100">
            <div class="alert alert-danger mt-5" asp-validation-summary="ModelOnly"></div>
            <form method="get">
                <div class="d-flex justify-content-between align-items-md-end gap-1 w-100">
                    <div class="row justify-content-start align-items-end mt-2 g-2">
                        <div class="dates-input col-12 col-md-5 mt-2">
                            <span>شروع از:</span>
                            <input data-jdp class="date-input form-control mt-1" type="text" asp-for="FromDate" placeholder="انتخاب تاریخ">
                        </div>
                        <div class="dates-input col-12 col-md-5 mt-2">
                            <span>تا پایان:</span>
                            <input data-jdp class="date-input form-control mt-1" type="text" asp-for="ToDate" placeholder="انتخاب تاریخ">
                        </div>
                        <div class="col-12 col-md-2 mt-2">
                            <button class="mt-2 search-date-btn" type="submit" data-type="primary-buttons">جستجو</button>
                        </div>
                    </div>
                </div>
            </form>
            <div class="d-flex flex-column">
                <a href="#" class="mt-2" download data-type='primary-buttons'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-download" viewBox="0 0 16 16">
                        <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                        <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
                    </svg>
                    <span class="mx-1">دانلود گزارش</span>
                </a>
            </div>
        </div>
        <div class="table-responsive overflow-x-auto">
            <table class="table table-striped table-hover table-hover data-table text-center mt-3 mb-2">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th>پنج سهم برتر</th>
                        <th>پنج سهم برتر به کل دارایی</th>
                        <th>سایر سهام</th>
                        <th>سایر سهام به کل دارایی</th>
                        <th>اوراق مشارکت</th>
                        <th>اوراق مشارکت به کل دارایی</th>
                        <th>اوراق سپرده</th>
                        <th>اوراق سپرده به کل دارایی</th>
                        <th>نقد و بانک (جاری و سپرده)</th>
                        <th>وجه نقد به کل دارایی</th>
                        <th>سایر دارایی‌ها</th>
                        <th>سایر دارایی‌ها به کل دارایی</th>
                        <th>صندوق سرمایه گذاری</th>
                        <th>صندوق سرمایه گذاری به کل دارایی</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Rows)
                    {
                        <tr>
                            <td>@item.Date.ToPersian()</td>
                            <td>@item.TopFiveStocks.ToString("##,0")</td>
                            <td>@item.TopFiveStocksPercent</td>
                            <td>@item.OtherStocks.ToString("##,0")</td>
                            <td>@item.OtherStocksPercent</td>
                            <td>@item.Bonds.ToString("##,0")</td>
                            <td>@item.BondsPercent</td>
                            <td>@item.DepositCertificates.ToString("##,0")</td>
                            <td>@item.DepositCertificatesPercent</td>
                            <td>@item.BankAndCach.ToString("##,0")</td>
                            <td>@item.BankAndCachPercent</td>
                            <td>@item.OtherAssets.ToString("##,0")</td>
                            <td>@item.OtherAssetsPercent</td>
                            <td>@item.FundInvestment.ToString("##,0")</td>
                            <td>@item.FundInvestmentPercent</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-center table-pagination mt-3" dir="ltr">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)">
                        <span aria-hidden="true">قبلی</span>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link" href="?PageNumber=@i">@i</a></li>
                }
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)" aria-label="Next">
                        <span aria-hidden="true">بعدی</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>
