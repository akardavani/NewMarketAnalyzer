@page
@model ForgotPasswordOtpModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "کد OTP فراموشی رمز عبور";
}

<div class="d-flex flex-column align-items-center justify-content-center shadow w-25 center pt-5 rounded-3">
    <a asp-page="Index" class="d-flex justify-content-center">
        <img class="logo img-fluid my-1" src="~/images/Mobin-Logo.png" alt="لوگوی مبین سرمایه" />
    </a>
    <header class="mt-1 w-100 text-center" data-type='pre-titles'>بازیابی رمز عبور حساب صندوق مبین سرمایه</header>
    <div class="regestration-form w-100">
        <form class="d-flex flex-column" method="post">
            <input type="hidden" asp-for="OtpLifetime" />
            <input type="hidden" asp-for="UserName" />
            <div class="alert alert-danger form-fields align-self-center mt-2" asp-validation-summary="ModelOnly"></div>
            <div class="form-fields align-self-center">
                <div data-type="small-text" class="form-guid text-right">رمز یکبار مصرف ارسال شده به شماره همراه ثبت شده در سجام را وارد کنید.</div>
                <div class="field d-flex flex-column mt-1 mb-5">
                    <div class="input-container otp-container d-flex flex-column w-100">
                        <input asp-for="OtpCode" class="m-0" type="text" placeholder="کد تایید موبایل">
                        <span class="otp-timer"></span>
                        <div id="ResendForgotPasswordOtp" data-ajax-url="/ForgotPasswordOtp?handler=ResendForgotPasswordOtp"></div>
                        <button type="button" class="resend-otp-link d-none border-0 bg-transparent" data-otp-invoke="true">دریافت کد جدید</button>
                    </div>
                    <span asp-validation-for="OtpCode" class="input-validation-alert"></span>
                </div>
                <div class="field d-flex flex-column">
                    <label for="NewPassword" class="label m-0 fw-bold">رمز عبور جدید</label>
                    <div class="input-container password-container d-flex flex-column w-100">
                        <input type="password" class="m-0 password-input" asp-for="NewPassword" placeholder="رمز عبور جدید">
                        <span class="eye-icon" data-password-visibility>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                            </svg>
                        </span>
                    </div>
                    <span asp-validation-for="NewPassword" class="input-validation-alert"></span>
                </div>
                <div class="field d-flex flex-column mb-3">
                    <label for="repeat-password" class="label m-0 fw-bold">تکرار رمز عبور جدید</label>
                    <div class="input-container password-container d-flex flex-column w-100">
                        <input type="password" class="m-0 password-input" asp-for="ConfirmPassword" placeholder="تکرار رمز عبور جدید">
                        <span class="eye-icon" data-password-visibility>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                            </svg>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="input-validation-alert"></span>
                </div>
                <div class="d-flex flex-column field">
                    <div class="label m-0 fw-bold">کد امنیتی</div>
                    <div class="captcha-field container">
                        <div class="row d-flex align-items-center justify-content-between">
                            <div class="col-4 input-container d-flex flex-column">
                                <input class="h-100" type="text" asp-for="CaptchaCode" placeholder="کد امنیتی">
                            </div>
                            <div class="col-8 d-flex align-items-center justify-content-end">
                                <div class="col-10 captcha-image p-0">
                                    <img id="captchaImage" class="img-fluid" data-refresh-captcha="true" src="/captcha" height="48" width="180" alt="تصویر امنیتی" />
                                </div>
                                <div class="col-2 refresh-captcha">
                                    <a class="change-captcha" data-refresh-captcha="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="CaptchaCode" class="input-validation-alert"></span>
                </div>
                <div class="field">
                    <button type="submit" data-type='primary-buttons' class="w-100">تایید</button>
                </div>
            </div>
        </form>
    </div>
</div>
