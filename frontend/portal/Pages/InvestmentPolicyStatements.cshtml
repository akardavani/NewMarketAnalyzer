@page
@model InvestmentPolicyStatementsModel
@{
    ViewData["Title"] = "بیانیه سیاست‌های سرمایه‌گذاری";
    int rowNo = 0;
}

<div class="container">
    <div class="d-flex flex-column justify-content-center align-items-center">
        <h3 data-type="pre-titles">بیانیه سیاست‌های سرمایه‌گذاری</h3>
        <table class="table table-striped table-hover data-table text-center mt-3 mb-5">
            <thead>
                <tr>
                    <th scope="col">ردیف</th>
                    <th scope="col">شرح</th>
                    <th scope="col">دانلود فایل</th>
                    <th scope="col">تاریخ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Rows)
                {
                    <tr>
                        <td>@(rowNo += 1)</td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-page="Prospectus" asp-page-handler="Download" asp-route-attachmentId="@item.AttachmentId" data-type="hyper-link">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download m-1" viewBox="0 0 16 16">
                                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                                    <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
                                </svg>@item.Description
                            </a>
                        </td>
                        <td><span dir="ltr">@item.Date.ToString("yyyy/MM/dd HH:mm:ss.fff")</span></td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
