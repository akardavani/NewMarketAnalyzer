@page
@model LoginHistoryModel
@{
    ViewData["Title"] = "تاریخچه ورود و خروج";
}

<div class="container">
    <div class="d-flex flex-column">
        <h3 data-type="pre-titles" class="align-self-center">تاریخچه ورود و خروج</h3>
        <div class="table-responsive overflow-x-auto">
            <table class="table table-striped data-table mt-3 mb-5">
                <thead>
                    <tr>
                        <th scope="col" width="120">آدرس IP</th>
                        <th scope="col" width="180">تاریخ</th>
                        <th scope="col">توضیحات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Rows)
                    {
                        <tr>
                            <td>@item.IpAddress</td>
                            <td><span dir="ltr">@item.EventDateTime.ToString("yyyy/MM/dd HH:mm:ss.fff")</span></td>
                            <td>@item.LoginResult</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-center table-pagination mt-3" dir="ltr">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)">
                        <span aria-hidden="true">قبلی</span>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link" href="?PageNumber=@i">@i</a></li>
                }
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)" aria-label="Next">
                        <span aria-hidden="true">بعدی</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>


