@page
@model ContactUsModel
@{
    ViewData["Title"] = "تماس با ما";
}

<div class="container">
    <div class="d-flex flex-column justify-content-center align-items-center my-5">
        <h3 data-type="pre-titles">تماس با ما</h3>
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12">
                <div class="wrapper">
                    <div class="row no-gutters shadow-lg contact-us-row my-5">
                        <div class="col-md-7 d-flex align-items-center">
                            <div class="contact-wrap w-100 p-md-5 p-4">
                                <form method="post">
                                    @if (Model.ContactUsResult is not null)
                                    {
                                        <div class="alert alert-success">@Model.ContactUsResult</div>
                                    }
                                    <div class="alert alert-danger mt-2" asp-validation-summary="ModelOnly"></div>
                                    <div class="row g-3">
                                        <div class="col-md-12 mt-0">
                                            <div class="form-group">
                                                <input asp-for="FullName" type="text" class="form-control contact-input" placeholder="نام و نام خانوادگی">
                                            </div>
                                            <span asp-validation-for="FullName" class="input-validation-alert"></span>
                                        </div>
                                        <div class="col-md-12 mt-0">
                                            <div class="form-group">
                                                <input asp-for="Email" type="email" class="form-control contact-input" placeholder="آدرس ایمیل">
                                            </div>
                                            <span asp-validation-for="Email" class="input-validation-alert"></span>
                                        </div>
                                        <div class="col-md-12 mt-0">
                                            <div class="form-group">
                                                <input asp-for="PhoneNumber" type="text" class="form-control contact-input" placeholder="شماره تماس">
                                            </div>
                                            <span asp-validation-for="PhoneNumber" class="input-validation-alert"></span>
                                        </div>
                                        <div class="col-md-12 mt-0">
                                            <div class="form-group">
                                                <input asp-for="Subject" type="text" class="form-control contact-input" placeholder="عنوان پیام">
                                            </div>
                                            <span asp-validation-for="Subject" class="input-validation-alert"></span>
                                        </div>
                                        <div class="col-md-12 mt-0">
                                            <div class="form-group">
                                                <textarea asp-for="Text" class="form-control contact-input" cols="30" rows="7" placeholder="پیام شما"></textarea>
                                            </div>
                                            <span asp-validation-for="Text" class="input-validation-alert"></span>
                                        </div>
                                        <div class="d-flex flex-column field mt-0">
                                            <div class="captcha-field container">
                                                <div class="row d-flex align-items-center justify-content-between">
                                                    <div class="col-4 input-container d-flex flex-column">
                                                        <input class="h-100" type="text" asp-for="CaptchaCode" placeholder="کد امنیتی">
                                                    </div>
                                                    <div class="col-8 d-flex align-items-center justify-content-end">
                                                        <div class="col-10 captcha-image p-0">
                                                            <img id="captchaImage" class="img-fluid" data-refresh-captcha="true" src="/captcha" height="48" width="180" alt="تصویر امنیتی" />
                                                        </div>
                                                        <div class="col-2 refresh-captcha refresh-center">
                                                            <a class="change-captcha" data-refresh-captcha="true">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                                                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                                                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                                                </svg>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <span asp-validation-for="CaptchaCode" class="input-validation-alert"></span>
                                        </div>
                                        <div class="col-md-12 mt-0">
                                            <div class="form-group d-flex justify-content-end">
                                                <button type="submit" data-type="primary-buttons">ارسال پیام</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-md-5 d-flex align-items-stretch contact-info">
                            <div class="info-wrap w-100 p-lg-5 p-4 d-flex flex-column">
                                <img class="logo img-fluid align-self-center mt-4" src="~/images/Mobin-Logo-White.png" alt="لوگوی مبین سرمایه" />
                                <h4 class="mb-4 mt-md-4">با ما در ارتباط باشید:</h4>
                                <div class="dbox w-100 d-flex align-items-start">
                                    <div class="icon d-flex align-items-center justify-content-center contact-info-item">
                                        <span class="fa fa-map-marker"></span>
                                    </div>
                                    <div class="text pl-3">
                                        <p><strong>آدرس:</strong> تهران، خیابان قائم مقام فراهانی، خیابان هشتم، پلاک 19</p>
                                    </div>
                                </div>
                                <div class="dbox w-100 d-flex align-items-center contact-info-item">
                                    <div class="icon d-flex align-items-center justify-content-center">
                                        <span class="fa fa-phone"></span>
                                    </div>
                                    <div class="text pl-3">
                                        <p><strong>شماره تماس:</strong> <a href="tel://1579">1579</a></p>
                                    </div>
                                </div>
                                <div class="dbox w-100 d-flex align-items-center contact-info-item">
                                    <div class="icon d-flex align-items-center justify-content-center">
                                        <span class="fa fa-paper-plane"></span>
                                    </div>
                                    <div class="text pl-3">
                                        <p><strong>پست الکترونیکی:</strong> <a href="mailto:smartadmin@mobinsb.com">smartadmin@mobinsb.com</a></p>
                                    </div>
                                </div>
                                <div class="dbox w-100 d-flex align-items-center contact-info-item">
                                    <div class="icon d-flex align-items-center justify-content-center">
                                        <span class="fa fa-globe"></span>
                                    </div>
                                    <div class="text pl-3">
                                        <p><strong>نشانی اینترنتی</strong> <a href="#">mobinsbfund.com</a></p>
                                    </div>
                                </div>
                                <div class="d-flex flex-column justify-content-center align-items-center mt-4 py-3 rounded-3 social-media">
