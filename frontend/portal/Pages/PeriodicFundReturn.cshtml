@page
@model PeriodicFundReturnModel
@{
    ViewData["Title"] = "بازدهی دوره‌ای صندوق";
}

<div class="container">
    <div class="d-flex flex-column period-asset">
        <h3 data-type="pre-titles" class="align-self-center">بازدهی دوره‌ای صندوق</h3>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end w-100">
            <form method="get">
                <div class="row justify-content-start align-items-end mt-2 g-2">
                    <div class="dates-input col-8 col-md-10 mt-2">
                        <span>تا پایان:</span>
                        <input type="text" data-jdp placeholder="انتخاب تاریخ" class="date-input form-control mt-1" asp-for="ToDate" />
                    </div>
                    <div class="col-4 col-md-2 mt-2">
                        <button class="mt-2 search-date-btn" type="submit" data-type="primary-buttons">جستجو</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="table-responsive overflow-x-auto">
            <table class="table table-striped table-hover data-table period-asset-table text-center mt-3 mb-2">
                <thead>
                    <tr>
                        <th>عنوان</th>
                        <th>از تاریخ</th>
                        <th>تا تاریخ</th>
                        <th>بازدهی صندوق</th>
                        <th>بازدهی شاخص</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PeriodicFundReturns.PeriodicFundReturn)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td>@item.FromDate.ToPersian()</td>
                            <td>@(Model.ToDate?.ToPersian() ?? Model.PeriodicFundReturns.LastNavDate.ToPersian())</td>
                            <td><span class="@(item.FundReturn >= 0 ? "" : "negative")">@item.FundReturn</span></td>
                            <td><span class="@(item.FundReturn >= 0 ? "" : "negative")">@item.IndexReturn</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
