@model IReadOnlyDictionary<string, string>

<div class="tab-pane fade" id="fund-info" role="tabpanel" aria-labelledby="fund-info-tab">
    <div class="container">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-2 g-lg-2">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="statistic-box">
                        <p class="statistic-title">@item.Key</p>
                        <small>@item.Value</small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
