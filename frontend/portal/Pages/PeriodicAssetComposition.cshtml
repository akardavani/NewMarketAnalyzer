@page
@model PeriodicAssetCompositionModel
@{
    ViewData["Title"] = "ترکیب دارایی‌های دوره‌ای";
}

<div class="container">
    <div class="d-flex flex-column">
        <h3 data-type="pre-titles" class="align-self-center">ترکیب دارایی‌های دوره‌ای</h3>
        <div class="alert alert-danger mt-5" asp-validation-summary="ModelOnly"></div>
        <form class="row justify-content-start align-items-end mt-2 g-2 w-50" method="get">
            <div class="dates-input col-12 col-md-5 mt-2">
                <span>تا پایان:</span>
                <input data-jdp class="date-input form-control mt-1" type="text" asp-for="ToDate" placeholder="انتخاب تاریخ">
            </div>
            <div class="col-12 col-md-2 mt-2">
                <button class="mt-2 search-date-btn" type="submit" data-type="primary-buttons">جستجو</button>
            </div>
        </form>
        <div class="table-responsive overflow-x-auto">
            <table class="table table-striped table-hover data-table period-asset-table text-center mt-3 mb-2">
                <thead>
                    <tr>
                        <th rowspan="2">شرح</th>
                        <th colspan="2">میانگین روزانه از ابتدای تأسیس صندوق</th>
                        <th colspan="2">میانگین روزانه دوره سه ماه گذشته</th>
                        <th colspan="2">میانگین روزانه یک ماه گذشته</th>
                        <th colspan="2">امروز</th>
                    </tr>
                    <tr>
                        <th>مبلغ</th>
                        <th>نسبت به کل دارایی</th>
                        <th>مبلغ</th>
                        <th>نسبت به کل دارایی</th>
                        <th>مبلغ</th>
                        <th>نسبت به کل دارایی</th>
                        <th>مبلغ</th>
                        <th>نسبت به کل دارایی</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>پنج سهم برتر به کل دارایی</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.TopFiveStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.TopFiveStocksPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.TopFiveStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.TopFiveStocksPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.TopFiveStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.TopFiveStocksPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.TopFiveStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.TopFiveStocksPercent</td>
                    </tr>

                    <tr>
                        <td>سایر سهام</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.OtherStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.OtherStocksPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.OtherStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.OtherStocksPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.OtherStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.OtherStocksPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.OtherStocks</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.OtherStocksPercent</td>
                    </tr>

                    <tr>
                        <td>اوراق مشارکت</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.Bonds</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.BondsPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.Bonds</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.BondsPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.Bonds</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.BondsPercent</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.Bonds</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.BondsPercent</td>
                    </tr>

                    <tr>
                        <td>صندوق سرمایه‌گذاری</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.FundInvestment</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageSinceEstablishment.FundInvestment</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.FundInvestment</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageNinetyDays.FundInvestment</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.FundInvestment</td>
                        <td>@Model.PeriodicAssetCompositionResult.DailyAverageThreetyDays.FundInvestment</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.FundInvestment</td>
                        <td>@Model.PeriodicAssetCompositionResult.Today.FundInvestment</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="9">مبالغ بر حسب میلیون ریال می‌باشد</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
