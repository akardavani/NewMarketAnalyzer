@page
@model LoginModel
@{
    ViewData["Title"] = "ورود";
    Layout = "_RegistrationLayout";
}
<style>
    .login-wrap { min-height: 100vh; display:flex; align-items:center; justify-content:center; padding: 32px 16px; background: #eef2f5; }
    .login-card { width: 100%; max-width: 1100px; background:#fff; border-radius: 24px; overflow:hidden; box-shadow: 0 25px 60px rgba(4,80,80,.25); }
    .login-card > .row { margin:0; }
    .login-hero { position: relative; min-height: 640px; background: url("~/images/Slide_20231061141194.jpg") center/cover no-repeat; color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 48px; }
    .login-hero::before { content:""; position:absolute; inset:0; background: linear-gradient(160deg, rgba(4,80,80,.92), rgba(9,100,100,.75)); }
    .login-hero > * { position: relative; }
    .login-hero h2 { font-size: 1.9rem; font-weight: 800; margin-top: 16px; text-align:center; }
    .login-hero p { opacity:.9; text-align:center; margin-top: 8px; }
    .login-form-col { padding: 56px 64px !important; display:flex; flex-direction:column; justify-content:center; }
    .login-form-col .regestration-form { max-width: 420px; margin: 0 auto; }
    @media (max-width: 991px) { .login-hero { min-height: 220px; } .login-form-col { padding: 32px 24px !important; } }
</style>

<section class="login-wrap">
    <div class="login-card">
        <div class="row g-0">
            <div class="login-hero col-lg-5 col-12 order-lg-2">
                <img class="logo img-fluid" style="max-width:220px" src="~/images/Mobin-Logo-White.png" alt="لوگوی مبین سرمایه" />
                <h2>سامانه جامع تحلیل بازار</h2>
                <p>صندوق سرمایه‌گذاری مشترک مبین سرمایه</p>
            </div>
            <div class="login-form-col col-lg-7 col-12 order-lg-1 text-center">
                <header class="mt-2 mb-2 w-100 fw-bold" style="font-size:1.6rem" data-type='pre-titles'>ورود به حساب کاربری</header>
                <p data-type="small-text">در صورتی که سجامی نیستید، برای ثبت‌نام در سجام <a href="https://profilesejam.csdiran.ir/" class="hyper-link" target="_blank" rel="noopener">اینجا</a> کلیک کنید.</p>

                <div class="regestration-form w-100">
                    <div class="alert alert-danger mt-2" asp-validation-summary="ModelOnly"></div>

                    <form class="d-flex flex-column" method="post">
                        <div class="form-fields align-self-center">
                            <div class="field d-flex flex-column">
                                <label for="username" class="label m-0 fw-bold">نام کاربری یا کد ملی</label>
                                <div class="input-container w-100">
                                    <input type="text" class="m-0" asp-for="UserName" placeholder="نام کاربری یا کد ملی">
                                </div>
                                <span asp-validation-for="UserName" class="input-validation-alert"></span>
                            </div>
                            <div class="field d-flex flex-column">
                                <label for="password" class="label m-0 fw-bold">رمز عبور</label>
                                <div class="input-container password-container d-flex flex-column w-100">
                                    <input type="password" class="m-0 password-input" asp-for="Password" placeholder="رمز عبور">
                                    <span class="eye-icon" data-password-visibility>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                        </svg>
                                    </span>
                                </div>
                                <span asp-validation-for="Password" class="input-validation-alert"></span>
                            </div>
                            <div class="field d-flex flex-column">
                                <div class="label m-0 fw-bold">کد امنیتی</div>
                                <div class="captcha-field container">
                                    <div class="row d-flex align-items-center justify-content-between">
                                        <div class="col-4 input-container d-flex flex-column">
                                            <input class="h-100" type="text" asp-for="CaptchaCode" placeholder="کد امنیتی">
                                        </div>
                                        <div class="col-8 d-flex align-items-center justify-content-end">
                                            <div class="col-10 captcha-image p-0">
                                                <img id="captchaImage" class="img-fluid" data-refresh-captcha="true" src="/captcha" height="48" width="180" alt="تصویر امنیتی" />
                                            </div>
                                            <div class="col-2 refresh-captcha">
                                                <a class="change-captcha" data-refresh-captcha="true">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                                        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                                    </svg>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="CaptchaCode" class="input-validation-alert"></span>
                            </div>
                            <div class="field">
                                <button type="submit" data-type='primary-buttons' class="w-100">ورود</button>
                            </div>
                        </div>
                    </form>
                    <div>
                        <p class="m-0">
                            حساب ندارید؟ <a asp-page="Signup" class="hyper-link">ثبت نام</a>
                        </p>
                        <p class="m-0">
                            <a asp-page="ForgotPassword" class="hyper-link">فراموشی رمز عبور</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
