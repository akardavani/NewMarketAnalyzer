@page
@model ResetPasswordResultModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "نتیجه بازیابی رمز عبور";
}

<div class="d-flex flex-column align-items-center justify-content-center shadow w-25 center p-5 rounded-3">
    <p class="text-justify">عملیات تغییر رمز عبور با موفقیت انجام شد. برای ادامه از طریق دکمه زیر وارد حساب کاربری خود شوید.</p>
    <a asp-page="/Login" class="align-self-center mb-0 mt-4" data-type="primary-buttons">ورود به حساب کاربری</a>
</div>
