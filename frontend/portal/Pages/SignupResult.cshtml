@page
@model MarketAnalyzer.Portal.Pages.SignupResultModel
@{
    ViewData["Title"] = "نتیجه ثبت‌نام";
    Layout = "_RegistrationLayout";
}

<div class="d-flex flex-column align-items-center justify-content-center shadow w-25 center p-5 rounded-3">
    <p class="text-justify">ثبت‌نام شما در سامانه با موفقیت انجام شد و نام کاربری و رمز عبور به شماره همراه شما ارسال شد. برای ادامه از طریق دکمه زیر و نام کاربری و رمز عبور پیامک شده وارد حساب کاربری خود شوید.</p>
    <a asp-page="/Login" class="align-self-center mb-0 mt-4" data-type="primary-buttons">بازگشت به صفحه ورود</a>
</div>
