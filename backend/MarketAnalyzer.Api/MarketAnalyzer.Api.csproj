<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591;NU1608</NoWarn>

	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
		<PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<StimulCrackFiles Include="StimulCrack/*.dll" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\shared\MarketAnalyzer.ApiClient\MarketAnalyzer.ApiClient.csproj" />
		<ProjectReference Include="..\Cms\src\MarketAnalyzer.Cms.Application\MarketAnalyzer.Cms.Application.csproj" />
		<ProjectReference Include="..\Membership\src\MarketAnalyzer.Membership.Application\MarketAnalyzer.Membership.Application.csproj" />

		<ProjectReference Include="..\MarketAnalyzer.Persistence\MarketAnalyzer.Persistence.csproj" />
		<ProjectReference Include="..\Common\src\MarketAnalyzer.Infrastructure\MarketAnalyzer.Infrastructure.csproj" />
		<ProjectReference Include="..\MarketIntelligence\src\MarketAnalyzer.MarketIntelligence.Application\MarketAnalyzer.MarketIntelligence.Application.csproj" />
		<ProjectReference Include="..\MarketIntelligence\src\MarketAnalyzer.MarketIntelligence.Persistence\MarketAnalyzer.MarketIntelligence.Persistence.csproj" />
		<ProjectReference Include="..\MarketIntelligence\src\MarketAnalyzer.MarketIntelligence.Collectors\MarketAnalyzer.MarketIntelligence.Collectors.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Templates\**\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
	<ItemGroup>
		<Content Include="Reports\**\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
	<!--<Target Name="CopyCustomContent" AfterTargets="AfterBuild">
		<Copy SourceFiles="@(StimulCrackFiles)" DestinationFolder="$(OutDir)" />
	</Target>-->
</Project>
