<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- لازم برای کلاینت SOAP سرویس TSETMC (ConnectedServices/TsePublic) -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- فهرست‌های ثابت نمادها (کریپتو-تومان، ماکرو و...) داخل DLL می‌آیند؛ با Bootstrap به دیتابیس می‌روند، نه با Seed دستی. -->
    <EmbeddedResource Include="Resources\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketAnalyzer.MarketData.Domain\MarketAnalyzer.MarketData.Domain.csproj" />
    <ProjectReference Include="..\MarketAnalyzer.MarketData.Application\MarketAnalyzer.MarketData.Application.csproj" />
  </ItemGroup>

</Project>
