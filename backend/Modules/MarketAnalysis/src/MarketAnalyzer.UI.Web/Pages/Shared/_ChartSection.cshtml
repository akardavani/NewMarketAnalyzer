@model MarketAnalyzer.UI.Web.UiChart
@using System.Text.Json
@using System.Text.Json.Serialization

@{
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    var chartId = string.IsNullOrWhiteSpace(Model.Id)
        ? $"chart_{Guid.NewGuid():N}"
        : Model.Id;
}

<div class="card shadow-sm">

    @if (!string.IsNullOrWhiteSpace(Model.Title))
    {
        <div class="card-header">
            @Model.Title
        </div>
    }

    <div class="card-body">
        <div style="height:700px;">
            <canvas id="@chartId"></canvas>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const canvas = document.getElementById("@chartId");

        console.log("chart canvas id:", "@chartId");
        console.log("chart canvas element:", canvas);

        if (!canvas) {
            console.error("Canvas not found for chart:", "@chartId");
            return;
        }

        if (!window.Chart) {
            console.error("Chart.js is not loaded");
            return;
        }

        const labels = @Html.Raw(JsonSerializer.Serialize(Model.Labels, jsonOptions));
        const datasets = @Html.Raw(JsonSerializer.Serialize(Model.Datasets, jsonOptions));

        console.log("chart labels:", labels);
        console.log("chart datasets:", datasets);

        new Chart(canvas, {
            type: 'line',
            data: {
                labels: labels,
                datasets: datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: false
                    }
                },
                plugins: {
                    legend: {
                        display: true
                    }
                }
            }
        });

    });
</script>

