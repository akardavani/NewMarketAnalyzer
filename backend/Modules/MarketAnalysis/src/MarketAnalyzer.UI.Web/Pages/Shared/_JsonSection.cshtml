@using System.Text.Json
@model object

@{
    var json = JsonSerializer.Serialize(
        Model,
        new JsonSerializerOptions
        {
            WriteIndented = true
        });
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <pre class="bg-light p-3 rounded border"><code>@json</code></pre>
    </div>
</div>
