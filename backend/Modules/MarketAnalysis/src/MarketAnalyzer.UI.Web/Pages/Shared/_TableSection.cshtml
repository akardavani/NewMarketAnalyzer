@using MarketAnalyzer.UI.Web
@model UiTable

@{
    var tableId = string.IsNullOrWhiteSpace(Model.Id)
        ? $"tbl_{Guid.NewGuid():N}"
        : Model.Id;
}

<div class="card shadow-sm mb-4">
    <div class="card-body">

        @if (Model.Columns == null || !Model.Columns.Any())
        {
            <div class="alert alert-warning mb-0">
                No columns available.
            </div>
        }
        else if (Model.Rows == null || !Model.Rows.Any())
        {
            <div class="alert alert-info mb-0">
                No data available.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="@tableId"
                       class="table table-striped table-hover table-bordered align-middle ui-data-table"
                       data-searching="@Model.EnableSearch.ToString().ToLower()"
                       data-paging="@Model.EnablePaging.ToString().ToLower()"
                       data-ordering="@Model.EnableSorting.ToString().ToLower()"
                       data-page-size="@Model.PageSize">

                    <thead class="table-dark">
                        <tr>
                            @foreach (var col in Model.Columns)
                            {
                                <th>@col</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @foreach (var col in Model.Columns)
                                {
                                    <td>
                                        @{
                                            row.TryGetValue(col, out var value);
                                        }

                                        @if (value is IEnumerable<UiLink> links)
                                        {
                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                @foreach (var link in links)
                                                {
                                                    <a href="@link.Url" target="@link.Target" class="@link.CssClass" title="@link.DisplayText">
                                                        @(!string.IsNullOrEmpty(link.Icon) ? link.Icon : link.DisplayText)
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else if (value is UiLink uiLink)
                                        {
                                            <a href="@uiLink.Url" target="@uiLink.Target" class="@uiLink.CssClass" title="@uiLink.DisplayText">
                                                @(!string.IsNullOrEmpty(uiLink.Icon) ? uiLink.Icon : uiLink.DisplayText)
                                            </a>
                                        }
                                        else
                                        {
                                            @FormatCellValue(value)
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>

@functions {
    private string FormatCellValue(object? value)
    {
        if (value == null)
            return "-";

        if (value is DateTime dt)
            return dt.ToString("yyyy-MM-dd HH:mm");

        if (value is decimal dec)
            return dec.ToString("N2");

        if (value is double dbl)
            return dbl.ToString("N2");

        if (value is float flt)
            return flt.ToString("N2");

        return value.ToString() ?? "-";
    }
}


