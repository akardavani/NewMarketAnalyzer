{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "CollectorSchedule": {
    "Collectors": [
      {
        "Name": "TseFundamentalCollector",
        "Enabled": true,
        "Timeframes": [
          {
            "Timeframe": "1m",
            "Cron": "0 0 22 * * *",
            //"Cron": "0 */40 * * * *",
            //"Cron": "0 */1 * * * *",
            "Methods": [ "FetchData" ]
          }
        ]
      },
      {
        "Name": "CoreSymbolCollector",
        "Enabled": true,
        "Timeframes": [
          {
            "Timeframe": "1m",
            //"Cron": "0 0 22 * * *",
            "Cron": "0 0 18 * * 5", // میشه جمعه ها ساعت 18
            //"Cron": "0 */3 * * * *",
            "Methods": [ "FetchSymbols" ]
          }
        ]
      },
      {
        "Name": "CoreCandleCollector",
        "Enabled": true,
        "Timeframes": [
          {
            "Timeframe": "1m",
            //"Cron": "0 0 12 * * *",            
            "Cron": "0 */10 * * * *",
            "Methods": [ "FetchCandles" ] // گرفتن دیتای روزانه
          },
          {
            "Timeframe": "1m",
            //"Cron": "0 0 22 * * *",
            "Cron": "0 0 18 * * 5", // میشه جمعه ها ساعت 18
            //"Cron": "0 */3 * * * *",
            "Methods": [ "FetchWeeklyCandles" ] // حذف و گرفتن دیتای بازار تهران
          }
        ]
      },
      {
        "Name": "StockCollector",
        "Enabled": true,
        "Timeframes": [
          //{
          //  "Timeframe": "1m",
          //  //"Cron": "0 0 18 * * 5", // میشه جمعه ها ساعت 18
          //  "Cron": "0 */1 * * * *",
          //  "Methods": [ "FetchEveryWeek" ] // هر هفنه همه دیتاها رو پاک مینه دوباره میشونه          
          {
            "Timeframe": "1h",
            "Cron": "0 0 22 * * *",
            //"Cron": "0 */1 * * * *",
            "Methods": [ "FetchStockSymbols" ]
          }
        ]
      },
      {
        "Name": "InvestmentFundCollector",
        "Enabled": true,
        "Timeframes": [
          {
            "Timeframe": "1D",
            // هر روز ساعت 22
            "Cron": "0 0 22 * * *",
            //"Cron": "0 */1 * * * *",
            //"Cron": "*/40 * * * * *",
            "Methods": [ "FetchInvestmentFundChart" ]
          }
        ]
      }
    ]
  }
}
